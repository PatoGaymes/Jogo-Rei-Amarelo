config_version=5

[application]

; Alteração de IA - Revisar
; O que faz: nome oficial do jogo, que aparece no título da janela.
; Por quê: definido pela equipe em 11/09/2026. Antes estava "Rei Amarrilho",
;          que era um nome provisório.
config/name="Contos de Outrora: O Rei De Amarelo"
run/main_scene="uid://uxsfpgd4b2mn"
config/features=PackedStringArray("4.6", "C#", "Forward Plus")
config/icon="res://icon.svg"

[display]

