; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Rei Amarrilho"
run/main_scene="uid://uxsfpgd4b2mn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; Alteração de IA - Revisar
; O que faz: liga a sincronização vertical (vsync).
; Por quê: estava desligado. Desligado, a imagem "rasga" (parte da tela mostra
;          um quadro e parte mostra outro) e a placa de vídeo trabalha a 100%
;          sem ganho nenhum. Ligado, o jogo acompanha a taxa do monitor.
window/vsync/vsync_mode=1

; Alteração de IA - Revisar
; O que faz: faz o jogo abrir numa janela de 1280x720 durante o desenvolvimento.
; Por quê: o jogo é desenhado em 1920x1080, e numa tela de 1920x1080 a janela de
;          teste não cabe (fica maior que o monitor). Estas duas linhas mudam só
;          o tamanho da janela; a arte continua sendo feita em 1920x1080.
;          No jogo publicado isso não tem efeito, é só para testar.
window/size/window_width_override=1280
window/size/window_height_override=720

[dotnet]

; Alteração de IA - Revisar
; O que faz: define o nome do arquivo de programa gerado pelo C# (ReiAmarrilho.dll).
; Por quê: antes era "Rei Amarrilho", com espaço. O espaço fazia o Godot procurar
;          um arquivo com nome diferente do que o C# gerava, e nenhum script
;          funcionava. Sem o espaço, os dois passam a bater.
project/assembly_name="ReiAmarrilho"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"

; Alteração de IA - Revisar
; O que faz: dá nomes às camadas de colisão 2D, que por padrão se chamam só
;            "Layer 1", "Layer 2" e assim por diante.
; Por quê: sem nome, ao configurar colisões o dev precisa lembrar de cor que
;          "camada 3" significa objeto com que se pode interagir. Com nome,
;          o painel do Godot mostra a palavra em vez do número.
[layer_names]

2d_physics/layer_1="Player"
2d_physics/layer_2="Enemy"
2d_physics/layer_3="Interactable"
2d_physics/layer_4="Wall"
2d_physics/layer_5="Trigger"

; Alteração de IA - Revisar
; O que faz: cria nomes para os comandos do jogo (andar, interagir, pausar...)
;            e liga cada nome às teclas correspondentes.
; Por quê: no código escrevemos "move_left" em vez de "tecla A". Assim, para
;          trocar a tecla ou adicionar suporte a controle, basta mexer aqui,
;          sem alterar nenhuma linha de programação.
;          As teclas abaixo são um ponto de partida e podem ser trocadas.
[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":65,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
